# -------------------------------
# 6. Sobel Edge Detection
# -------------------------------

image = cv2.imread('image.jpg')

gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)

sobel_x = cv2.Sobel(
    gray,
    cv2.CV_64F,
    1,
    0,
    ksize=3
)

sobel_y = cv2.Sobel(
    gray,
    cv2.CV_64F,
    0,
    1,
    ksize=3
)

magnitude = cv2.magnitude(
    sobel_x.astype(np.float32),
    sobel_y.astype(np.float32)
)

plt.imshow(magnitude, cmap='gray')
plt.title('Sobel Edge Detection')
plt.axis('off')
plt.show()


# -------------------------------
# 7. Prewitt Edge Detection
# -------------------------------

image = cv2.imread('image.jpg')

gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)

kernel_x = np.array([
    [-1, 0, 1],
    [-1, 0, 1],
    [-1, 0, 1]
])

kernel_y = np.array([
    [1, 1, 1],
    [0, 0, 0],
    [-1, -1, -1]
])

prewitt_x = cv2.filter2D(
    gray,
    -1,
    kernel_x
)

prewitt_y = cv2.filter2D(
    gray,
    -1,
    kernel_y
)

magnitude = cv2.magnitude(
    prewitt_x.astype(np.float32),
    prewitt_y.astype(np.float32)
)

plt.imshow(magnitude, cmap='gray')
plt.title('Prewitt Edge Detection')
plt.axis('off')
plt.show()
